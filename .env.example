# Server
NODE_ENV=production
PORT=8000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/goprep?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# OTP — set OTP_MOCK=false in production once Twilio/SMTP are configured
# OTP_MOCK=true forces mock even in production; omit to auto-mock in non-production
OTP_EXPIRY_MINUTES=10
# OTP_MOCK=false

# Twilio SMS OTP
# Account SID must start with AC (Console → Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=
# Optional API Key auth (SID starts with SK)
TWILIO_API_KEY_SID=
TWILIO_CLIENT_SECRET=
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# OTP_MOCK=false

# Nodemailer / SMTP email OTP (Gmail: use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ExamZone <noreply@example.com>"
APP_NAME=ExamZone

# Admin seed (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI (optional)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Firebase push (optional — use multiline private key on server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
